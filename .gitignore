# things I do not want to put on github
*.pyc
__pycache__/
db.sqlite3
venv/
env/

# The real environment file holds passwords and the secret key, so it
# must never be committed. The example file has no real values in it and
# is committed on purpose so others know which variables to set.
.env
!.env.example

staticfiles/
.DS_Store
.vscode/
.idea/

# Sphinx build cache. The finished HTML documentation in
# docs/_build/html is committed on purpose, but these doctree files are
# just an internal cache that changes on every build.
docs/_build/doctrees/

# The course task brief PDFs are not mine to publish, so keep them out
# of the public repository.
*.pdf
