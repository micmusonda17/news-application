# Example environment file for the News Application.
#
# Copy this file to ".env" and fill in your own values:
#
#     cp .env.example .env
#
# ".env" is listed in .gitignore, so the real values never reach GitHub.
# This example file is committed on purpose, so that anybody cloning the
# repository can see which variables they need to supply.
#
# Docker Compose reads ".env" automatically from this folder. If you run
# the project in a virtual environment instead of Docker, export these
# variables in your shell first (use "set" instead of "export" on
# Windows).


# --- Django -----------------------------------------------------------

# Generate your own with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-this-with-your-own-generated-key

# Comma separated list of hostnames the site may be served under.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost


# --- Database ---------------------------------------------------------

# "False" uses MariaDB, "True" falls back to SQLite (handy for tests).
USE_SQLITE=False

DB_NAME=news_application
DB_USER=news_user
DB_PASSWORD=choose-your-own-password

# Used only by the MariaDB container in docker-compose.yml.
DB_ROOT_PASSWORD=choose-your-own-root-password

# Under Docker Compose the database is reached at the service name "db".
# Running without Docker, use 127.0.0.1 instead.
DB_HOST=db
DB_PORT=3306


# --- Email ------------------------------------------------------------

# Leave these empty to have emails printed to the console instead of
# actually being sent.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
